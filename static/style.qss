QWidget {
    background-color: #1e1e24;
    color: #e3e3e6;
    font-family: "Segoe UI", "Helvetica Neue", Arial, sans-serif;
    font-size: 14px;
}

QSplitter::handle {
    background-color: #2d2d34;
}
QSplitter::handle:horizontal {
    width: 4px;
}
QSplitter::handle:vertical {
    height: 4px;
}

QTabWidget::pane {
    border: none;
    background-color: #151518;
}

QTabBar::tab {
    background-color: #25252b;
    color: #a0a0a8;
    padding: 8px 16px;
    border-top-left-radius: 4px;
    border-top-right-radius: 4px;
    margin-right: 2px;
    border: none;
}

QTabBar::tab:hover {
    background-color: #2d2d34;
    color: #e3e3e6;
}

QTabBar::tab:selected {
    background-color: #151518;
    color: #ffffff;
    font-weight: 600;
}

QTreeView {
    background-color: #1a1a1f;
    border: none;
    color: #c9c9cf;
    font-size: 13px;
}

QTreeView::item {
    padding: 6px;
    border-radius: 4px;
}

QTreeView::item:hover {
    background-color: #25252b;
    color: #e3e3e6;
}

QTreeView::item:selected {
    background-color: #2d2d34;
    color: #ffffff;
}

QPushButton {

}

QPushButton:hover {
    background-color: #2d2d34;
    border-color: #ffffff;
}

QPushButton:pressed {
    background-color: #151518;
}

QLabel {
    color: #a0a0a8;
    font-weight: bold;
    padding: 4px;
}

QMenuBar {
    background-color: #1e1e24;
    border-bottom: 1px solid #2d2d34;
}

QMenuBar::item {
    background: transparent;
    padding: 6px 10px;
}

QMenuBar::item:selected {
    background-color: #2d2d34;
    border-radius: 4px;
}

QMenu {
    background-color: #25252b;
    border: 1px solid #3a3a42;
    border-radius: 4px;
    padding: 4px 0px;
}

QMenu::item {
    padding: 6px 24px;
}

QMenu::item:selected {
    background-color: #2d2d34;
    color: #00bfff;
}

QPlainTextEdit {
    font-family: "Consolas", "Fira Code", "Courier New", monospace;
    font-size: 15px;
    color: #e3e3e6;
    background-color: #151518;
    border: none;
    padding: 8px;
}