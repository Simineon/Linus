/* аппле даже не мечтала о таком стиле */
QTabWidget::pane {
    background-color: #4682b4;
    border: 1px;
}

QTabBar::tab {
    background-color: #4682b4;
    color: white;
    padding: 8px 12px;
    margin-right: 2px;
}

QTabBar::tab:selected {
    background-color: #00bfff;
    font-weight: bold;
}

QTabBar::tab:hover {
    background-color: rgb(0, 131, 226);
}

QTreeView {
    background-color: #f5f5f5;
    alternate-background-color: #e9e9e9;
    border: 1px solid #d3d3d3;
}

QTreeView::item {
    padding: 5px;
    border-bottom: 1px solid #d3d3d3;
}

QTreeView::item:selected {
    background-color: #4682b4;
    color: white;
}
